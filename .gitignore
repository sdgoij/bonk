target/
**/*.rs.bk

# Local databases and keys must never be committed.
*.db
*.db-wal
*.db-shm
*.key
keystore.bin

# OS noise
.DS_Store
Thumbs.db

# Release SBOMs, generated per tag by `cargo cyclonedx`.
*.cdx.json

# Mobile build outputs, generated bindings and native libraries, and local SDK paths.
mobile/.gradle/
mobile/.idea/
mobile/**/build/
mobile/.kotlin/
mobile/local.properties
mobile/**/jniLibs/
# Android Studio's generated Gradle daemon JVM criteria (it can pin a different
# JDK than the project's toolchain).
mobile/gradle/gradle-daemon-jvm.properties
