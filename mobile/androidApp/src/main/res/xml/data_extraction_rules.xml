<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup is false, and this is the explicit belt-and-braces rule: no
  archive, keystore, or preference is offered to cloud backup or device
  transfer. Backups are the app's own encrypted export, not the platform's.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
